    "@playwright/test": "^1.56.0",
    "@vitejs/plugin-vue": "^5.2.0",
    "prettier": "^3.10.1",
    "typescript": "~5.7.0",
    "vite": "^6.4.0",
    "vue-tsc": "^2.2.0"
  }
}
