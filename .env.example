TOWN_DATABASE_URL=sqlite:///.local/town.db
TOWN_TICK_SECONDS=2
TOWN_STARTUP_TIMEOUT=30
TOWN_DATABASE_TIMEOUT=3
TOWN_HEALTH_TIMEOUT=2
TOWN_COOKIE_SECURE=false
# Generate one persistent Fernet key for a deployment. Local setup generates .local/secret.key.
# TOWN_ENCRYPTION_KEY=
# PostgreSQL deployment: postgresql+psycopg://town:password@localhost:5432/town
